{
  "name": "telecloud-storage",
  "version": "1.0.0",
  "description": "Unlimited Cloud Storage powered by Telegram Saved Messages & Bots",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "postinstall": "npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.9",
    "telegram": "^2.26.22",
    "uuid": "^11.1.0"
  }
}
