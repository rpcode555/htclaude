{
  "name": "telecloud-storage",
  "version": "1.0.0",
  "private": true,
  "description": "Unlimited Cloud Storage powered by Telegram Saved Messages",
  "main": "server/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm test && npm run check:syntax && npm run build",
    "test": "node --test",
    "dev": "concurrently \"nodemon server/index.js\" \"npm run dev --prefix client\"",
    "postinstall": "npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.9",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "uuid": "^11.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
